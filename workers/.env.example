# Python Workers Environment Variables
# Copy to .env and fill in actual values

# Database
DATABASE_URL=postgresql://ontrip_user:changeme@localhost:5432/ontrip

# Redis (Celery broker)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# External APIs
VIATOR_API_KEY=your_viator_key_here
GETYOURGUIDE_API_KEY=your_gyg_key_here
KLOOK_API_KEY=your_klook_key_here

# Scraping Configuration
USER_AGENT=OnTripBot/1.0 (+https://ontrip.com/bot)
RESPECT_ROBOTS_TXT=true
MIN_REQUEST_DELAY_SECONDS=2
MAX_CONCURRENT_REQUESTS=5

# Monitoring
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project
LOG_LEVEL=INFO

# Worker Configuration
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3000

# Ingestion Schedule
TIER_1_REFRESH_HOURS=2
TIER_2_REFRESH_HOURS=24
TIER_4_REFRESH_HOURS=72

# Data Quality
MIN_COMPLETENESS_SCORE=0.6
MIN_PRICING_CONFIDENCE=0.3
ENABLE_AUTO_APPROVAL=false
