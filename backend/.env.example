# Backend Environment Variables
# Copy to .env and fill in actual values

# Database
DATABASE_URL=postgresql://ontrip_user:changeme@localhost:5432/ontrip
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=changeme

# Server
NODE_ENV=development
API_PORT=3001
CORS_ORIGIN=*

# Authentication
JWT_SECRET=GENERATE_RANDOM_256BIT_KEY_HERE
JWT_EXPIRY=7d
ADMIN_API_KEY=GENERATE_RANDOM_KEY_HERE

# External APIs
VIATOR_API_KEY=your_viator_key_here
GETYOURGUIDE_API_KEY=your_gyg_key_here
KLOOK_API_KEY=your_klook_key_here

# Monitoring
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Cache TTL (seconds)
CACHE_SEARCH_TTL=300
CACHE_PACKAGE_TTL=3600
CACHE_OPERATOR_TTL=86400

# Feature Flags
ENABLE_TIER_3_SCRAPING=false
ENABLE_TIER_7_SCRAPING=false
ENABLE_MANUAL_REVIEW=true

# AWS (Production only)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=ontrip-assets-prod

# Email (Future)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
